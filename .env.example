# Database
DATABASE_URL="postgresql://user:password@localhost:5432/atcm_eventos"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
